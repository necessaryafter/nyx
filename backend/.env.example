DATABASE_URL=postgresql://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=studio-assets
MINIO_BUCKET_VIDEOS=studio-videos

BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (opcional — deixe vazio pra desabilitar)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth (opcional — deixe vazio pra desabilitar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Créditos (custo por minuto estimado)
RENDER_CREDITS_PER_MIN=10
TTS_CREDITS_PER_MIN=5

PORT=3000

# Comma-separated user IDs allowed to generate API keys
ADMIN_USER_IDS=

# Encryption key for API keys stored in DB (32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
